# 在本目录复制为 .env，并在本地填写。不要提交真实 Key。
# 沿用课程已跑通的模型名与接口配置。
AGENTSEEK_MODEL=
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=
TAVILY_API_KEY=

# 可选：Jev 结构化决策工具，密钥从 https://console.typesafe.ai 获取。
TYPESAFE_API_KEY=

# 2048 可选功能：1 保留按需加载入口（默认），0 完全关闭；修改后重启。
MIE_ENABLE_2048=1

# 仅在以后真正调用 Agent 时产生运行记录。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mie-assistant
